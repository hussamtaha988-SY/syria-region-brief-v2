# Copy to .env for local testing. NEVER commit the real .env file.
# In GitHub Actions these come from repository Secrets, not from this file.

# Google AI Studio (Gemini) API key - FREE tier, do NOT enable billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gmail account used to SEND the digest (must have 2-Step Verification + App Password).
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where to deliver the digest.
DIGEST_TO=you@example.com

# Optional overrides
# NO_AI=1            # force fallback mode (no Gemini calls)
# MAX_ITEMS=10
